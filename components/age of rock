
#define UART_BAUD     600    
#define MONITOR_BAUD  600   
#define PACKET_SIZE   4        
#define READ_TIMEOUT  2000      

void setup() {


  Serial.begin(MONITOR_BAUD);
  while (!Serial) { ; }           // Wait for USB Serial to be ready
  Serial.println("─────────────────────────────────────");
  Serial.println(" UART Packet Reader — Metro M0 Express");
  Serial.println(" Baud: 600 | Format: 8N1 | Non-Inverted");
  Serial.println("─────────────────────────────────────\n");

  Serial1.begin(UART_BAUD, SERIAL_8N1);
  Serial.println("[INFO] Serial1 listening at 600 baud on D0 (RX)...\n");
}

int readPacket() {
  int bytesRead = 0;
  unsigned long startTime = millis();

  while (bytesRead < PACKET_SIZE) {

    // Check for timeout
    if (millis() - startTime >= READ_TIMEOUT) {
      Serial.print("[WARN] Timeout! Only received ");
      Serial.print(bytesRead);
      Serial.println(" byte(s) before timeout.");
      break;
    }

    // Read next byte if available
    if (Serial1.available() > 0) {
      packetBuffer[bytesRead] = Serial1.read();
      bytesRead++;
    }
  }

  return bytesRead;
}



void parsePacket(int length) {
  Serial.println("──── Packet Received ────────────────────");

  // Print raw HEX values
  Serial.print("[HEX]   ");
  for (int i = 0; i < length; i++) {
    if (packetBuffer[i] < 0x10) Serial.print("0");  // Leading zero padding
    Serial.print(packetBuffer[i], HEX);
    Serial.print(" ");
  }
  Serial.println();

  // Print raw DEC values
  Serial.print("[DEC]   ");
  for (int i = 0; i < length; i++) {
    Serial.print(packetBuffer[i], DEC);
    Serial.print(" ");
  }
  Serial.println();

  // Print as ASCII (printable characters only)
  Serial.print("[ASCII] ");
  for (int i = 0; i < length; i++) {
    if (packetBuffer[i] >= 32 && packetBuffer[i] <= 126) {
      Serial.print((char)packetBuffer[i]);
    } else {
      Serial.print(".");   // Non-printable shown as dot
    }
  }
  Serial.println();

  Serial.println("─────────────────────────────────────────\n");
}



void loop() {

  // Wait until at least 1 byte is available before attempting a read
  if (Serial1.available() > 0) {
    Serial.println("[INFO] Data detected — reading packet...");

    int bytesRead = readPacket();

    if (bytesRead > 0) {
      parsePacket(bytesRead);
    } else {
      Serial.println("[WARN] No bytes read.");
    }
  }
}
