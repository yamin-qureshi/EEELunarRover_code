// ─────────────────────────────────────────────────────────────────
// UART Packet Reader — Adafruit Metro M0 Express
// Baud Rate : 600
// Logic     : Non-Inverted (standard TTL)
// Hardware  : Serial1 → D0 (RX), D1 (TX)
// Monitor   : Serial  → USB (115200 baud)
// ─────────────────────────────────────────────────────────────────

// ── Configuration ────────────────────────────────────────────────
#define UART_BAUD     600       // Incoming UART baud rate
#define MONITOR_BAUD  600    // USB Serial monitor baud rate
#define PACKET_SIZE   4        // Expected bytes per packet (adjust as needed)
#define READ_TIMEOUT  2000      // Packet read timeout in milliseconds

// ── Packet Buffer ─────────────────────────────────────────────────
uint8_t packetBuffer[PACKET_SIZE];  // Buffer to store incoming packet bytes


// ─────────────────────────────────────────────────────────────────
// Setup
// ─────────────────────────────────────────────────────────────────
void setup() {

  // USB Serial — for debug output to Serial Monitor
  Serial.begin(MONITOR_BAUD);
  while (!Serial) { ; }           // Wait for USB Serial to be ready
  Serial.println("─────────────────────────────────────");
  Serial.println(" UART Packet Reader — Metro M0 Express");
  Serial.println(" Baud: 600 | Format: 8N1 | Non-Inverted");
  Serial.println("─────────────────────────────────────\n");

  // Hardware UART — Serial1 on D0 (RX) / D1 (TX)
  // SERIAL_8N1 = 8 data bits, No parity, 1 stop bit (non-inverted)
  Serial1.begin(UART_BAUD, SERIAL_8N1);
  Serial.println("[INFO] Serial1 listening at 600 baud on D0 (RX)...\n");
}


// ─────────────────────────────────────────────────────────────────
// Read a full packet into packetBuffer[]
// Returns the number of bytes successfully read
// ─────────────────────────────────────────────────────────────────
int readPacket() {
  int bytesRead = 0;
  unsigned long startTime = millis();

  while (bytesRead < PACKET_SIZE) {

    // Check for timeout
    if (millis() - startTime >= READ_TIMEOUT) {
      Serial.print("[WARN] Timeout! Only received ");
      Serial.print(bytesRead);
      Serial.println(" byte(s) before timeout.");
      break;
    }

    // Read next byte if available
    if (Serial1.available() > 0) {
      packetBuffer[bytesRead] = Serial1.read();
      bytesRead++;
    }
  }

  return bytesRead;
}


// ─────────────────────────────────────────────────────────────────
// Parse and print the received packet
// Customize this to match your specific packet structure
// ─────────────────────────────────────────────────────────────────
void parsePacket(int length) {
  Serial.println("──── Packet Received ────────────────────");

  // Print raw HEX values
  Serial.print("[HEX]   ");
  for (int i = 0; i < length; i++) {
    if (packetBuffer[i] < 0x10) Serial.print("0");  // Leading zero padding
    Serial.print(packetBuffer[i], HEX);
    Serial.print(" ");
  }
  Serial.println();

  // Print raw DEC values
  Serial.print("[DEC]   ");
  for (int i = 0; i < length; i++) {
    Serial.print(packetBuffer[i], DEC);
    Serial.print(" ");
  }
  Serial.println();

  // Print as ASCII (printable characters only)
  Serial.print("[ASCII] ");
  for (int i = 0; i < length; i++) {
    if (packetBuffer[i] >= 32 && packetBuffer[i] <= 126) {
      Serial.print((char)packetBuffer[i]);
    } else {
      Serial.print(".");   // Non-printable shown as dot
    }
  }
  Serial.println();

  // ── Add your custom packet parsing logic below ──────────────────
  // Example: packetBuffer[0] = header byte
  //          packetBuffer[1..8] = data bytes
  //          packetBuffer[9] = checksum
  // ────────────────────────────────────────────────────────────────

  Serial.println("─────────────────────────────────────────\n");
}


// ─────────────────────────────────────────────────────────────────
// Main Loop
// ─────────────────────────────────────────────────────────────────
void loop() {

  // Wait until at least 1 byte is available before attempting a read
  if (Serial1.available() > 0) {
    Serial.println("[INFO] Data detected — reading packet...");

    int bytesRead = readPacket();

    if (bytesRead > 0) {
      parsePacket(bytesRead);
    } else {
      Serial.println("[WARN] No bytes read.");
    }
  }
}
